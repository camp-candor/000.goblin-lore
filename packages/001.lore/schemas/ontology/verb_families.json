            "capability_required": "epistemic_suspicion",
            "required_limbs": 0,
            "lemmas": [
                "sniff",
                "inspect",
                "hesitate",
                "pour_out",
                "refuse_drink",
                "scrutinize",
                "suspect"
            ]
