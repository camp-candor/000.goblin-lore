{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "version": "1.0.0",
    "families": {
        "LOCOMOTION_RAPID": {
            "capability_required": "bipedal_sprint",
            "required_limbs": 2,
            "lemmas": [
                "sprint",
                "run",
                "dash",
                "bolt",
                "scamper",
                "vault",
                "charge"
            ]
        },
        "LOCOMOTION_VERTICAL": {
            "capability_required": "climb",
            "required_limbs": 2,
            "lemmas": ["climb", "scramble", "scale", "shinny"]
        },
        "BIMANUAL_GRIP": {
            "capability_required": "two_functional_arms",
            "required_limbs": 2,
            "lemmas": [
                "heave",
                "pry",
                "wring",
                "strangle",
                "haul",
                "wield_two_handed"
            ]
