---
import '../styles/global.css'
import { loadCorpusSnapshotFromDisk } from '../lib/lore/corpusServer'
import {
    LORE_MENU_CHOICES,
    buildBootBannerLines,
    createInitialCockpitSession,
} from '../lib/lore/menuRegistry'

export const prerender = false

const initialCorpus = loadCorpusSnapshotFromDisk()
const initialSession = createInitialCockpitSession(initialCorpus)
const initialBootLines = buildBootBannerLines(initialSession)
const serializedCorpus = JSON.stringify(initialCorpus).replace(/</g, '\\u003c')
---

<!DOCTYPE html>
<html lang="en" class="h-full w-full m-0 p-0 bg-black overflow-hidden">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>995.LIBRARY // TERMINAL FLIGHT DECK</title>
        <meta
            name="description"
            content="Goblin Lore Ontological Compiler & Audit Deck -- 12x12 Dual-Pane Blessed Terminal Cockpit"
        />
        <meta property="og:title" content="995.LIBRARY // TERMINAL FLIGHT DECK" />
        <meta
            property="og:description"
            content="Goblin Lore Ontological Compiler & Audit Deck -- 12x12 Dual-Pane Blessed Terminal Cockpit"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="h-full w-full m-0 p-0 bg-black text-[#00cd00] font-mono overflow-hidden">
        <div
            id="lore-terminal-root"
            tabindex="0"
            role="application"
            aria-label="995.LIBRARY // TERMINAL FLIGHT DECK"
            class="relative w-screen h-dvh bg-black overflow-hidden font-mono text-[12px] lg:text-[13px] xl:text-[14px] leading-[1.35] select-none focus:outline-none"
        >
            <span
                id="lore-char-caliper"
                aria-hidden="true"
                class="fixed -top-[200px] -left-[200px] opacity-0 pointer-events-none font-mono"
            >
                M
            </span>

            <div
                id="lore-top-left"
                class="absolute left-0 top-0 w-[33.333333%] h-[33.333333%] bg-black overflow-hidden"
            >
            </div>

            <nav
                id="lore-choice-nav"
                aria-label="Lore Cockpit Choices"
                class="absolute left-0 top-[33.333333%] w-[33.333333%] h-[66.666667%] bg-black overflow-y-auto overflow-x-hidden"
            >
                <div class="flex flex-col gap-0 w-full">
                    {
                        LORE_MENU_CHOICES.map((choice, idx) => (
                            <button
                                type="button"
                                class={`block w-full text-left font-mono whitespace-nowrap overflow-hidden h-[1.35em] leading-[1.35em] pl-[2ch] pr-[1ch] border-0 rounded-none cursor-pointer focus:outline-none ${
                                    idx === 0
                                        ? 'bg-[#cd0000] text-white'
                                        : 'bg-[#cdcd00] text-black hover:bg-[#cd0000] hover:text-white'
                                }`}
                            >
                                {choice.label}
                            </button>
                        ))
                    }
                </div>
            </nav>

            <section
                aria-label="Console Log"
                class="absolute left-[33.333333%] top-0 w-[66.666667%] h-full bg-black text-[#00cd00] overflow-hidden"
            >
                <div
                    class="absolute top-0 left-[2ch] z-10 bg-black text-[#00cd00] px-[0.2ch] leading-[1.35] pointer-events-none"
                >
                    Console Log
                </div>

                <div
                    id="lore-console-scroll"
                    class="w-full h-full overflow-y-auto overflow-x-hidden pt-[1.35em] pr-[1ch] pb-[0.5em]"
                >
                    {
                        initialBootLines.map((line) => (
                            <div class="whitespace-pre font-mono leading-[1.35em] min-h-[1.35em] text-[#00cd00]">
                                {line}
                            </div>
                        ))
                    }
                </div>
            </section>
        </div>

        <div
            id="lore-terminated-view"
            class="hidden w-screen h-dvh bg-black text-[#00cd00] font-mono text-[13px] leading-[19px] p-[2ch] cursor-pointer select-none overflow-hidden"
        >
            <div>&gt;&gt; [TERMINAL] Clean teardown complete. Screen restored.</div>
            <div>&gt;&gt; [PROCESS EXITED 0] goblin-lore CLI session closed.</div>
            <div class="mt-2 text-[#e5e5e5]">
                Press ENTER or click anywhere to reboot `npm run tui`...
            </div>
        </div>

        <script
            id="lore-corpus-data"
            type="application/json"
            set:html={serializedCorpus}
        ></script>

        <script>
            import { mountTerminalCockpit } from '../lib/lore/mountTerminalCockpit'
            mountTerminalCockpit()
        </script>
    </body>
</html>
