---
import '../styles/global.css';

interface Props {
  bodyClass?: string;
}

const { bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>The Portal</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Epilogue:wght@400;700;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,700;1,6..72,400&family=Space+Grotesk:wght@300;400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,700;1,400&family=Courier+Prime:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class:list={[
      'bg-background-light dark:bg-background-dark font-display text-primary dark:text-paper transition-colors duration-200 snap-container',
      bodyClass,
    ]}
  >
    <slot />
  </body>
</html>
